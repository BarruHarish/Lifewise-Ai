# LifeWise AI Environment Configuration Example

# FastAPI Backend Settings
PROJECT_NAME="LifeWise AI Advisory Platform"
API_V1_STR="/api"

# Database Configuration:
# Default fallback to SQLite:
DATABASE_URL="sqlite:///./lifewise.db"
# Or configure PostgreSQL when available:
# DATABASE_URL="postgresql://user:password@localhost:5432/lifewise_db"

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
